ANTHROPIC_API_KEY=your-api-key-here

# Google OAuth (optional — app works without auth, sessions will be anonymous)
# Get these from Google Cloud Console → APIs & Services → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
COOKIE_SECRET=your-32-char-random-secret

# Session persistence (recommended in production)
# Use Railway Postgres DATABASE_URL, or set SESSION_DATABASE_URL to override.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# SESSION_DATABASE_URL=postgresql://user:password@host:5432/dbname
